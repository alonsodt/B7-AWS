# =============================================================
# .env.example — Plantilla de variables de entorno
# =============================================================
# Cómo usarlo:
#   1. Copia este fichero como `.env`   (cp .env.example .env)
#   2. Rellena los valores en TU `.env`
#   3. `.env` está en .gitignore: nunca se sube al repositorio.
#
# Aquí NO van claves de acceso de AWS. En local se usa un perfil
# configurado con `aws configure sso` o `aws configure`; en GitHub
# Actions se entra por OIDC.

# Perfil y región de AWS
AWS_PROFILE=
AWS_REGION=

# Bucket S3 donde guardamos los PDF y los manifiestos
S3_BUCKET=

# Modelo de Bedrock para la extracción (id del modelo o del perfil de inferencia)
BEDROCK_MODEL_ID=

# Base de datos (Aurora + RDS Data API). Son identificadores, no contraseñas:
# la contraseña vive en AWS Secrets Manager y aquí solo va el ARN del secreto.
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=

# URL de la API (la usa la app Streamlit)
API_URL=
